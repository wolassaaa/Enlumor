{
  "name": "enlumor",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Local-first PDF reading workspace",
  "author": "Enlumor",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:python": "node scripts/python.mjs -m unittest discover -s tests/python -v",
    "test:e2e": "npm run build && playwright test",
    "start": "electron .",
    "build:worker": "node scripts/build-worker.mjs",
    "pack": "npm run build && npm run build:worker && electron-builder --win dir",
    "portable": "npm run build && npm run build:worker && electron-builder --win portable",
    "release:verified": "node scripts/release.mjs"
  },
  "build": {
    "appId": "local.enlumor.reader",
    "productName": "Enlumor",
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".cache/pdf-worker/enlumor-pdf-worker",
        "to": "pdf-worker"
      },
      {
        "from": "python",
        "to": "python",
        "filter": [
          "*.py"
        ]
      }
    ],
    "win": {
      "target": "portable"
    },
    "artifactName": "Enlumor-${version}-win.${ext}"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}

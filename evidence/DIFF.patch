+test('cancel, corrupt, encrypted and image-only PDFs have explicit outcomes', async () => {
+  const scan = path.join(folder, 'image-only.pdf'), encrypted = path.join(folder, 'locked.pdf'), corrupt = path.join(folder, 'broken.pdf');

+import{it,expect}from'vitest';
+import{buildPageBlocks,type TextSpan}from'../src/renderer/cruise-blocks';
+const doc={id:'doc',fingerprint:'a'.repeat(64)},styles={font:{ascent:.8,descent:-.2}};
+const span=(str:string,x:number,y:number,width=100):TextSpan=>({str,width,height:14,transform:[14,0,0,14,x,y],fontName:'font'});
+it('keeps repeated phrases in separate columns with original native quads and stable identity',()=>{const items=[span('same phrase',40,700),span('same phrase',340,700),span('left second',40,680),span('right second',340,680)];const blocks=buildPageBlocks(doc,0,600,items,styles);expect(blocks).toHaveLength(2);expect(blocks[0].quote).toBe('same phrase\nleft second');expect(blocks[1].quote).toBe('same phrase\nright second');expect(blocks[0].quads).toHaveLength(2);expect(blocks[1].quads[0][0]).toBe(340);expect(blocks[1].id).not.toBe(blocks[0].id);expect(buildPageBlocks(doc,0,600,items,styles)).toEqual(blocks);});
+it('preserves Chinese and multi-line evidence without injecting a screen scale',()=>{const blocks=buildPageBlocks(doc,2,600,[span('中文原文',50,700),span('第二行',50,682)],styles);expect(blocks).toHaveLength(1);expect(blocks[0].quote).toBe('中文原文\n第二行');expect(blocks[0].pageIndex).toBe(2);expect(blocks[0].quads[0]).toEqual([50,711.2,150,711.2,50,697.2,150,697.2]);});
+it('handles headers and footers spanning columns in vertical reading bands',()=>{const items=[span('HEADER',30,780,540),span('L1',40,700),span('R1',340,700),span('L2',40,680),span('R2',340,680),span('FOOTER',30,40,540)];const blocks=buildPageBlocks(doc,0,600,items,styles);expect(blocks.map(b=>b.quote)).toEqual(['HEADER','L1\nL2','R1\nR2','FOOTER']);});
+it('empty pages are not given fabricated blocks; fingerprint and page bind identity',()=>{expect(buildPageBlocks(doc,0,600,[],styles)).toEqual([]);const items=[span('evidence',40,700)];expect(buildPageBlocks({...doc,fingerprint:'b'.repeat(64)},0,600,items,styles)[0].id).not.toBe(buildPageBlocks(doc,0,600,items,styles)[0].id);expect(buildPageBlocks(doc,1,600,items,styles)[0].id).not.toBe(buildPageBlocks(doc,0,600,items,styles)[0].id);});
+it('caps block size at text-item boundaries rather than inventing per-character geometry',()=>{const items=Array.from({length:20},(_,i)=>span('x'.repeat(100),40,800-i*18));const blocks=buildPageBlocks(doc,0,600,items,styles);expect(blocks.length).toBeGreaterThan(1);expect(blocks.every(b=>b.quote.length<=1200)).toBe(true);expect(blocks.reduce((n,b)=>n+b.quote.replace(/\n/g,'').length,0)).toBe(2000);expect(()=>buildPageBlocks(doc,0,600,[span('x'.repeat(1201),40,700)],styles)).toThrow('CRUISE_BLOCK_TOO_LONG');});
+it('rejects invalid geometry and page metadata without returning inaccurate anchors',()=>{for(const item of [{...span('x',40,700),width:NaN},{...span('x',40,700),transform:[0,0,0,0,0,0]}])expect(()=>buildPageBlocks(doc,0,600,[item],styles)).toThrow(/CRUISE_/);expect(()=>buildPageBlocks(doc,-1,600,[span('x',40,700)],styles)).toThrow(/CRUISE_/);});
+it.each([320,340])('keeps wide columns separate at right start %s',right=>{const blocks=buildPageBlocks(doc,0,600,[span('L1',40,700,260),span('R1',right,700,220),span('L2',40,682,260),span('R2',right,682,220)],styles);expect(blocks.map(b=>b.quote)).toEqual(['L1\nL2','R1\nR2']);expect(blocks[0].quads.every(q=>q[2]===300)).toBe(true);expect(blocks[1].quads.every(q=>q[0]===right)).toBe(true);});

+  const piece:Piece={text:item.str,left:Math.min(...corners.map(p=>p[0])),right:Math.max(...corners.map(p=>p[0])),top:Math.max(...corners.map(p=>p[1])),bottom:Math.min(...corners.map(p=>p[1])),base:m[5],height:h,source};

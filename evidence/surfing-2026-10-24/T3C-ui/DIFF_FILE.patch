+ it('prepares a host-verified local snapshot without any model request',async()=>{const h=setup();const s=await h.runtime.prepare('doc');expect(s.context.documentId).toBe('doc');expect(s.passages[0].id).toBe('surf-0-0-0');expect(h.network).toEqual([]);expect(JSON.stringify(s)).not.toContain('HOST_PATH');});
+ it('requires preparation and explicit known context capacity before generation',async()=>{const h=setup();const s=await h.runtime.prepare('doc');await expect(h.runtime.route({request:{requestId:'r',profileId:'local',context:s.context,consent:true},contextWindowTokens:0})).rejects.toThrow('SURFING_CAPACITY_UNKNOWN');expect(h.network).toEqual([]);});
+ it('routes only an explicitly confirmed prepared document',async()=>{const h=setup();const s=await h.runtime.prepare('doc');await h.runtime.route({request:{requestId:'r',profileId:'local',context:s.context,consent:true},contextWindowTokens:10000});expect(h.network).toHaveLength(1);expect(h.events[0].type).toBe('route');});
+ it('invalidates old context on document change',async()=>{const h=setup();const a=await h.runtime.prepare('first');await h.runtime.prepare('second');await expect(h.runtime.route({request:{requestId:'r',profileId:'local',context:a.context,consent:true},contextWindowTokens:10000})).rejects.toThrow('SURFING_STALE');expect(h.network).toEqual([]);});
+ it('old panel cleanup cannot cancel a newly prepared document',async()=>{const h=setup();const a=await h.runtime.prepare('first');const b=await h.runtime.prepare('second');h.runtime.deactivate(a.context);expect(h.runtime.getContext()).toEqual(b.context);});
+ it('does not allow renderer paths or extra wrapper fields',async()=>{const h=setup();const s=await h.runtime.prepare('doc');await expect(h.runtime.route({request:{requestId:'r',profileId:'local',context:s.context,consent:true},contextWindowTokens:10000,source:'private'} as any)).rejects.toThrow('SURFING_INVALID_REQUEST');expect(h.network).toEqual([]);});
+});
+
+it('reports stale preparation to the caller instead of leaving UI waiting for an event',async()=>{const h=setup();const s=await h.runtime.prepare('doc');h.runtime.invalidate();await expect(h.runtime.route({request:{requestId:'r',profileId:'local',context:s.context,consent:true},contextWindowTokens:10000})).rejects.toThrow('SURFING_STALE');expect(h.network).toEqual([]);});

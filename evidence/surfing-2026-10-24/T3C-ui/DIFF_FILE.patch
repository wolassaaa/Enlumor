+function setup(){const events:any[]=[],network:any[]=[];const ports:SurfingRuntimePorts={verified:id=>({id,path:'HOST_PATH',fingerprint,pageCount:1}),extract:async()=>({fingerprint,pageCount:1,pages:[{pageIndex:0,passages:[{id:'surf-0-0-0',quote:'Paper source',quads:[[0,10,20,10,0,0,20,0]]}]}]}),profile:id=>({id,name:'fixture',protocol:'openai-chat',endpoint:'http://localhost/v1',model:'gpt-4o-mini',maxOutputTokens:100,timeoutMs:1000,parameters:{}}),measureInputTokens:()=>200,generate:async(_p,prompt)=>{network.push(prompt);return JSON.stringify({stops:[{title:'Problem',reason:'Start here',passageIds:['surf-0-0-0']}]});},emit:e=>events.push(e)};return{ports,network,events,runtime:new SurfingRuntime(ports)};}

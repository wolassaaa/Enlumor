+it('timeout and external cancellation close transport and return fixed codes',async()=>{const s=await wsFixture(()=>{});try{await expect(generateSpark({...p,endpoint:s.url,timeoutMs:100},prompt)).rejects.toThrow('AI_TIMEOUT');const c=new AbortController(),job=generateSpark({...p,endpoint:s.url},prompt,{signal:c.signal});setTimeout(()=>c.abort(),20);await expect(job).rejects.toThrow('AI_CANCELLED');}finally{await s.close();}});
+it('rejects repeated sequences and unsupported output frames rather than duplicating text',async()=>{const s=await wsFixture((_input,send)=>{send(frame('one',0,0));send(frame('one',2,0));});try{await expect(generateSpark({...p,endpoint:s.url},prompt)).rejects.toThrow('AI_INVALID_RESPONSE');}finally{await s.close();}});

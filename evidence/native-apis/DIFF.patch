+const p:AiProfileInput={id:'spark',name:'Spark fixture',protocol:'spark',endpoint:'wss://spark-api.xf-yun.com/v1.1/chat',model:'lite',credential:{kind:'spark',appId:'fixture-app',apiKey:'fixture-key',apiSecret:'fixture-secret'},parameters:{},maxOutputTokens:100,timeoutMs:500};const prompt={system:'system data',user:'中文原文'};const frame=(content:string,status=1,seq=0)=>({header:{code:0,status},payload:{choices:{status,seq,text:[{content,role:'assistant',index:0}]}}});
